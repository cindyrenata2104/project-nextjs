generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Inventory {
  id           Int             @id @default(autoincrement())
  jenis_barang String
  ukuran       String
  status       StatusInventory
  Peminjaman   Peminjaman[]
}

model Karyawan {
  id           Int          @id @default(autoincrement())
  nama         String
  jabatan      String
  periode      String
  tanggal_mulai DateTime?
  tanggal_selesai DateTime?
  status_kerja StatusKerja
  Peminjaman   Peminjaman[]
}

model Peminjaman {
  id                 Int           @id @default(autoincrement())
  karyawan_id        Int
  inventory_id       Int
  tanggal_peminjaman DateTime
  inventory          Inventory     @relation(fields: [inventory_id], references: [id])
  karyawan           Karyawan      @relation(fields: [karyawan_id], references: [id])
  Pengembalian       Pengembalian?
}

model Pengembalian {
  id                   Int        @id @default(autoincrement())
  peminjaman_id        Int        @unique
  tanggal_pengembalian DateTime
  peminjaman           Peminjaman @relation(fields: [peminjaman_id], references: [id])
}

model Riwayat {
  id            Int      @id @default(autoincrement())
  id_karyawan   Int?
  nama_karyawan String?
  id_barang     Int?
  jenis_barang  String?
  jenis         String
  aktivitas     String
  keterangan    String
  tanggal       DateTime @default(now())
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
}

enum StatusInventory {
  tersedia
  dipinjam
}

enum StatusKerja {
  active
  inactive
}


